# Server-only. Never put these values in index.html or browser bundles.
DATABASE_URL=
# Server-only PEM content from the trusted Supabase CA download (not a Windows path).
# Keep DATABASE_URL sslmode=verify-full; remove sslrootcert/other query parameters.
DATABASE_CA_CERT=
MIGRATION_DATABASE_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=
HOST=127.0.0.1
PORT=3100
# Optional disposable PostgreSQL database for integration testing.
TEST_DATABASE_URL=

APP_ENV=staging

# Public build configuration. Only sb_publishable_* keys accepted; never service-role keys.
SUPABASE_URL=https://cquhddsrhnacbkvszitl.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server-only Cloudinary Test environment. No default credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Checkout (server-only). Public site origin used for eGHL return/callback URLs, e.g. https://<staging-host>
PUBLIC_BASE_URL=
# eghl = eGHL test environment (same gateway as the Shopify store); mock = staging-only simulated gateway.
PAYMENT_PROVIDER=mock
# Explicit opt-in for operator-controlled Sandbox testing only. Both eGHL hashes remain unverified.
# The operator must independently confirm EGHL_PAYMENT_URL belongs to the Sandbox, never live.
EGHL_SANDBOX_ENABLED=false
# eGHL merchant credentials from eGHL (sandbox first). Never commit or paste these anywhere else.
EGHL_SERVICE_ID=
EGHL_PASSWORD=
# eGHL hosted payment page URL for the environment (test URL from eGHL for sandbox).
EGHL_PAYMENT_URL=
# Mock gateway signing secret (staging only, at least 32 random characters).
MOCK_PAYMENT_SECRET=

# Server-only external Staging scheduler token (at least 32 random characters). Never send in a URL.
# No scheduler is configured or deployed by this repository. See docs/V3-AUDIT.md.
MAINTENANCE_SECRET=
