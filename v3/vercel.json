{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":null,
 "git":{"deploymentEnabled":{"**":false,"main":false,"update/v3-tls-ca":false,"staging":true}},
 "ignoreCommand":"node scripts/preview-policy.mjs",
 "installCommand":"npm ci",
 "buildCommand":"npm run build",
 "outputDirectory":"public",
 "functions":{"api/index.mjs":{"maxDuration":30}},
 "rewrites":[
  {"source":"/api/v3/:path*","destination":"/api/index"},
  {"source":"/health","destination":"/api/index"},
  {"source":"/admin","destination":"/admin/index.html"},
  {"source":"/pages/:slug","destination":"/page.html"},
  {"source":"/products/:handle","destination":"/shop.html"},
  {"source":"/cart","destination":"/shop.html"},
  {"source":"/checkout","destination":"/shop.html"},
  {"source":"/order/:number*","destination":"/shop.html"},
  {"source":"/pay/mock","destination":"/shop.html"}
 ],
 "headers":[{"source":"/(.*)","headers":[
  {"key":"X-Robots-Tag","value":"noindex, nofollow"},
  {"key":"X-Content-Type-Options","value":"nosniff"},
  {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
  {"key":"X-Frame-Options","value":"DENY"}
 ]}]
}
